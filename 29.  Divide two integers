class Solution {
public:
    int divide(int dividend, int divisor) {
        if (dividend == INT_MIN && divisor == -1) return INT_MAX;
         long a = labs(dividend), b = labs(divisor), ans = 0;
         bool sign = (dividend < 0) ^ (divisor < 0);

         while (a >= b) {
            long temp = b, count = 1;
            while (a >= (temp << 1)) {
                temp <<= 1;
                count <<= 1;
            }
            a -= temp;
            ans += count;
         }
         return sign ? -ans : ans;
    }
};
